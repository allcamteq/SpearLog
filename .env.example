# Leave both unset to use a local libSQL file (./local.db) for development.
# Set both to point at a hosted Turso database (needed for Vercel deploys,
# since Vercel's serverless filesystem can't persist a local .db file).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Used by Auth.js to sign/encrypt session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set a distinct value in each environment (local, Vercel).
AUTH_SECRET=

# Powers the "Fetch tide & current data" button (tide extremes + ocean
# current). Sign up at https://stormglass.io for a key — free tier is
# ~50 requests/day.
STORMGLASS_API_KEY=

# Powers location geocoding (location <-> GPS on Marks, and location lookups
# for tide/current fetches). Leave unset for local dev — it falls back to the
# free Nominatim endpoint, which works fine from a home IP. REQUIRED in any
# hosted environment (Vercel etc.): Nominatim blocks requests from cloud/
# datacenter IPs, so geocoding silently fails there without this set. Sign up
# for a free key (5,000 requests/day) at https://locationiq.com.
LOCATIONIQ_API_KEY=

# Powers session photo uploads. Create a Blob store on your Vercel project
# (Storage tab -> Create Database -> Blob) and copy the generated token —
# Vercel also injects this automatically into deployed environments once a
# Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
